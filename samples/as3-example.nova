    "scripts": [
      {
        "id": "8dd132de-cfd1-44e3-88ae-54ee327da762",
        "name": "Box.as",
        "path": "scripts/Box.as",
        "source": "package {\n    import flash.display.MovieClip;\n    import flash.events.Event;\n\n    public class Box extends MovieClip {\n        public var speed:Number = 2;\n        private var direction:Number = 1;\n        private var frames:int = 0;\n\n        public function Box() {\n            trace(\"Box gestartet\");\n            addEventListener(Event.ENTER_FRAME, update);\n        }\n\n        private function update(event:Event):void {\n            frames += 1;\n            x += speed * direction;\n            rotation += 0.5;\n            if (x > 520) {\n                direction = -1;\n            }\n            if (x < 40) {\n                direction = 1;\n            }\n        }\n    }\n}\n",
        "linkedObject": "87163e27-a9f4-4dc5-9ce2-c9483ed59e0a"
      }
    ],

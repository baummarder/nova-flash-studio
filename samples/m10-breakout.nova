    "scripts": [
      {
        "id": "e49f6fb2-3ce7-4d9e-b44f-79f81c8b549f",
        "name": "Main.as",
        "path": "scripts/Main.as",
        "source": "package {\n    import flash.display.MovieClip;\n    import flash.display.Graphics;\n    import flash.events.Event;\n    import flash.text.TextField;\n    import flash.text.TextFormat;\n    import flash.ui.Keyboard;\r\n    import flash.utils.getTimer;\n    import game.Input;\n    import game.Collision;\n    import game.Random;\n\n    /// Arkanoid-style breakout. Bricks, paddle and ball are drawn\n    /// programmatically; lives and score live in a TextField.\n    public dynamic class Main extends MovieClip {\n        private var paddle:MovieClip;\n        private var ball:MovieClip;\n        private var hud:TextField;\n        private var bricks = [];\n        private var rows:int = 5;\n        private var cols:int = 8;\n        private var score:int = 0;\n        private var lives:int = 3;\n        private var lastTime:int = 0;\n        private var stuck:Boolean = true;\n\n        public function Main() {\n            Input.init(stage);\n            build();\n            addEventListener(Event.ENTER_FRAME, update);\n        }\n\n        private function box(w:Number, h:Number, color:Number):MovieClip {\n            var s:MovieClip = new MovieClip();\n            var g:Graphics = s.graphics;\n            g.beginFill(color);\n            g.drawRect(-w / 2, -h / 2, w, h);\n            g.endFill();\n            return s;\n        }\n\n        private function build():void {\n            var brickW:Number = (stage.stageWidth - 80) / cols;\n            var brickH:Number = 22;\n            for (var r:int = 0; r < rows; r++) {\n                for (var c:int = 0; c < cols; c++) {\n                    var hue:Number = 0x3366FF + r * 0x003300;\n                    var b:MovieClip = box(brickW - 4, brickH - 4, hue);\n                    b.x = 40 + brickW * (c + 0.5);\n                    b.y = 60 + brickH * (r + 0.5);\n                    addChild(b);\n                    bricks.push(b);\n                }\n            }\n            paddle = box(90, 14, 0xE8E8E8);\n            paddle.x = stage.stageWidth / 2;\n            paddle.y = stage.stageHeight - 40;\n            addChild(paddle);\n            ball = box(14, 14, 0xFFFFFF);\n            ball.x = paddle.x;\n            ball.y = paddle.y - 20;\n            addChild(ball);\n            hud = new TextField();\n            var fmt:TextFormat = new TextFormat();\n            fmt.size = 22;\n            fmt.color = 0xFFFFFF;\n            hud.defaultTextFormat = fmt;\n            hud.x = 16;\n            hud.y = 16;\n            addChild(hud);\n            updateHud();\n        }\n\n        private function updateHud():void {\n            hud.text = \"Punkte: \" + score + \"   Leben: \" + lives;\n        }\n\n        private function serve():void {\n            stuck = false;\n            ball.vx = (Random.range(2) - 1) * 200;\n            ball.vy = -300;\n            if (ball.vx == 0) {\n                ball.vx = 150;\n            }\n        }\n\n        private function update(event:Event):void {\n            var now:int = getTimer();\n            var dt:Number = (now - lastTime) / 1000;\n            lastTime = now;\n            if (dt <= 0 || dt > 0.1) {\n                dt = 0.016;\n            }\n            Input.poll();\n\n            if (Input.down(Keyboard.LEFT)) {\n                paddle.x = paddle.x - 380 * dt;\n            }\n            if (Input.down(Keyboard.RIGHT)) {\n                paddle.x = paddle.x + 380 * dt;\n            }\n            if (paddle.x < 40 + paddle.width / 2) { paddle.x = 40 + paddle.width / 2; }\n            if (paddle.x > stage.stageWidth - 40 - paddle.width / 2) { paddle.x = stage.stageWidth - 40 - paddle.width / 2; }\n\n            if (stuck) {\n                ball.x = paddle.x;\n                ball.y = paddle.y - 20;\n                if (Input.pressed(Keyboard.SPACE)) {\n                    serve();\n                }\n                updateHud();\n                return;\n            }\n\n            ball.x = ball.x + ball.vx * dt;\n            ball.y = ball.y + ball.vy * dt;\n\n            // Walls\n            if (ball.x < 20 + ball.width / 2) {\n                ball.x = 20 + ball.width / 2;\n                ball.vx = -ball.vx;\n            }\n            if (ball.x > stage.stageWidth - 20 - ball.width / 2) {\n                ball.x = stage.stageWidth - 20 - ball.width / 2;\n                ball.vx = -ball.vx;\n            }\n            if (ball.y < 50 + ball.height / 2) {\n                ball.y = 50 + ball.height / 2;\n                ball.vy = -ball.vy;\n            }\n\n            // Paddle\n            if (Collision.objectsOverlap(ball, paddle) && ball.vy > 0) {\n                ball.vy = -ball.vy * 1.04;\n                ball.vx = ball.vx + (ball.x - paddle.x) * 5;\n                var maxV:Number = 560;\n                if (ball.vx > maxV) { ball.vx = maxV; }\n                if (ball.vx < -maxV) { ball.vx = -maxV; }\n            }\n\n            // Bricks\n            var i:int = bricks.length - 1;\n            while (i >= 0) {\n                var b:MovieClip = bricks[i];\n                if (b.parent != null && Collision.objectsOverlap(ball, b)) {\n                    if (ball.vy > 0) { ball.vy = -ball.vy; }\n                    else { ball.vy = -ball.vy; }\n                    if (ball.vx > 0) { ball.vx = -ball.vx; }\n                    else { ball.vx = -ball.vx; }\n                    removeChild(b);\n                    bricks.splice(i, 1);\n                    score = score + 10;\n                }\n                i = i - 1;\n            }\n\n            // Miss\n            if (ball.y > stage.stageHeight + 30) {\n                lives = lives - 1;\n                if (lives <= 0) {\n                    hud.text = \"Game Over! Punkte: \" + score + \"  (Leertaste = Neustart)\";\n                    stuck = true;\n                    lives = 3;\n                    score = 0;\n                    rebuildBricks();\n                } else {\n                    stuck = true;\n                    ball.vx = 0;\n                    ball.vy = 0;\n                }\n            }\n            updateHud();\n        }\n\n        private function rebuildBricks():void {\n            // Bricks were removed permanently; rebuild only when needed.\n            // For simplicity the level restarts with a fresh brick field.\n            var brickW:Number = (stage.stageWidth - 80) / cols;\n            var brickH:Number = 22;\n            for (var r:int = 0; r < rows; r++) {\n                for (var c:int = 0; c < cols; c++) {\n                    var b:MovieClip = box(brickW - 4, brickH - 4, 0x3366FF + r * 0x003300);\n                    b.x = 40 + brickW * (c + 0.5);\n                    b.y = 60 + brickH * (r + 0.5);\n                    addChild(b);\n                    bricks.push(b);\n                }\n            }\n        }\n    }\n}\n",
        "provenance": "original_source"
      },
      {
        "id": "62208916-305a-4b47-aca2-6565f92e2cc2",
        "name": "Input.as",
        "path": "scripts/game/Input.as",
        "source": "package game {\n    import flash.display.Stage;\n    import flash.events.KeyboardEvent;\n    import flash.events.MouseEvent;\n\n    /// Keyboard/mouse state helper. Call `init(stage)` once from the document\n    /// class constructor, `poll()` once per frame, then query `down`/`pressed`.\n    public class Input {\n        private static var held:Object = {};\n        private static var consumed:Object = {};\n        private static var target:Stage = null;\n        public static var mouseX:Number = 0;\n        public static var mouseY:Number = 0;\n\n        public static function init(stage:Stage):void {\n            target = stage;\n            stage.addEventListener(KeyboardEvent.KEY_DOWN, onKeyDown);\n            stage.addEventListener(KeyboardEvent.KEY_UP, onKeyUp);\n            stage.addEventListener(MouseEvent.MOUSE_MOVE, onMouseMove);\n        }\n\n        private static function onKeyDown(e:KeyboardEvent):void {\n            held[e.keyCode] = true;\n        }\n\n        private static function onKeyUp(e:KeyboardEvent):void {\n            held[e.keyCode] = false;\n            consumed[e.keyCode] = false;\n        }\n\n        private static function onMouseMove(e:MouseEvent):void {\n            mouseX = e.stageX;\n            mouseY = e.stageY;\n        }\n\n        /// Called once per frame after all `pressed` queries of the previous\n        /// frame are done. Resets edge-detection memory for released keys.\n        public static function poll():void {\n            // Nothing to copy: `consumed` is cleared lazily inside `pressed`.\n        }\n\n        public static function down(code:int):Boolean {\n            return held[code] == true;\n        }\n\n        /// True only on the frame the key went down (edge trigger).\n        public static function pressed(code:int):Boolean {\n            if (held[code] == true && consumed[code] != true) {\n                consumed[code] = true;\n                return true;\n            }\n            if (held[code] != true) {\n                consumed[code] = false;\n            }\n            return false;\n        }\n    }\n}\n",
        "provenance": "original_source"
      },
      {
        "id": "78b35a60-de95-409c-bd21-2c6bee0af70e",
        "name": "Collision.as",
        "path": "scripts/game/Collision.as",
        "source": "package game {\n    import flash.display.DisplayObject;\n\n    /// Axis-aligned and radial collision helpers operating on plain numbers.\n    /// Display objects are measured by their `x`/`y`/`width`/`height` bounds,\n    /// which works for programmatically drawn sprites.\n    public class Collision {\n        public static function aabb(\n            x1:Number, y1:Number, w1:Number, h1:Number,\n            x2:Number, y2:Number, w2:Number, h2:Number\n        ):Boolean {\n            return x1 < x2 + w2 && x1 + w1 > x2 && y1 < y2 + h2 && y1 + h1 > y2;\n        }\n\n        public static function circle(\n            cx1:Number, cy1:Number, r1:Number,\n            cx2:Number, cy2:Number, r2:Number\n        ):Boolean {\n            var dx:Number = cx1 - cx2;\n            var dy:Number = cy1 - cy2;\n            var rr:Number = r1 + r2;\n            return dx * dx + dy * dy < rr * rr;\n        }\n\n        public static function pointInRect(\n            px:Number, py:Number, x:Number, y:Number, w:Number, h:Number\n        ):Boolean {\n            return px >= x && px <= x + w && py >= y && py <= y + h;\n        }\n\n        /// AABB test between two display objects using their bounds.\n        public static function objectsOverlap(a:DisplayObject, b:DisplayObject):Boolean {\n            return aabb(a.x, a.y, a.width, a.height, b.x, b.y, b.width, b.height);\n        }\n    }\n}\n",
        "provenance": "original_source"
      },
      {
        "id": "b51ecc53-7292-4e0f-a7de-5d30114cfe59",
        "name": "Physics.as",
        "path": "scripts/game/Physics.as",
        "source": "package game {\n    import flash.display.DisplayObject;\n\n    /// Minimal velocity/gravity integration for display objects. Velocity is\n    /// stored in dynamic `vx`/`vy` properties on the object itself.\n    public class Physics {\n        /// Integrates one body: gravity, then position. `gravity` is px/s^2.\n        public static function stepBody(body:DisplayObject, dt:Number, gravity:Number):void {\n            body.vy = body.vy + gravity * dt;\n            body.x = body.x + body.vx * dt;\n            body.y = body.y + body.vy * dt;\n        }\n\n        /// Applies a horizontal acceleration, clamped to `maxSpeed`.\n        public static function accelerate(body:DisplayObject, accel:Number, maxSpeed:Number, dt:Number):void {\n            body.vx = body.vx + accel * dt;\n            if (body.vx > maxSpeed) {\n                body.vx = maxSpeed;\n            }\n            if (body.vx < -maxSpeed) {\n                body.vx = -maxSpeed;\n            }\n        }\n\n        /// Simple ground collision response: keeps `body` above `floorY`\n        /// (bottom edge) and kills downward velocity on contact.\n        /// Returns true while the body rests on the floor.\n        public static function floor(body:DisplayObject, floorY:Number):Boolean {\n            if (body.y + body.height > floorY) {\n                body.y = floorY - body.height;\n                if (body.vy > 0) {\n                    body.vy = 0;\n                }\n                return true;\n            }\n            return false;\n        }\n    }\n}\n",
        "provenance": "original_source"
      },
      {
        "id": "5d73a696-1672-4174-ab94-23d84fef389f",
        "name": "Camera.as",
        "path": "scripts/game/Camera.as",
        "source": "package game {\n    import flash.display.DisplayObject;\n\n    /// Follow camera for games built on a single world container. Apply the\n    /// result with `applyTo(world)` each frame.\n    public class Camera {\n        public var x:Number = 0;\n        public var y:Number = 0;\n        public var zoom:Number = 1;\n        private var target:DisplayObject = null;\n        private var lerp:Number = 6;\n\n        public function follow(mc:DisplayObject):void {\n            target = mc;\n        }\n\n        /// Advances the camera toward the follow target. Pass world bounds as\n        /// four numbers; use 0/0/0/0 for unbounded.\n        public function update(\n            dt:Number, viewW:Number, viewH:Number,\n            boundL:Number, boundT:Number, boundR:Number, boundB:Number\n        ):void {\n            if (target == null) {\n                return;\n            }\n            var tx:Number = target.x + target.width / 2;\n            var ty:Number = target.y + target.height / 2;\n            var t:Number = dt * lerp;\n            if (t > 1) {\n                t = 1;\n            }\n            x = x + (tx - x) * t;\n            y = y + (ty - y) * t;\n            var halfW:Number = viewW / (2 * zoom);\n            var halfH:Number = viewH / (2 * zoom);\n            if (boundR > boundL) {\n                var loX:Number = boundL + halfW;\n                var hiX:Number = boundR - halfW;\n                if (loX <= hiX) {\n                    if (x < loX) { x = loX; }\n                    if (x > hiX) { x = hiX; }\n                }\n            }\n            if (boundB > boundT) {\n                var loY:Number = boundT + halfH;\n                var hiY:Number = boundB - halfH;\n                if (loY <= hiY) {\n                    if (y < loY) { y = loY; }\n                    if (y > hiY) { y = hiY; }\n                }\n            }\n        }\n\n        /// Positions `world` so the camera centre lands mid-view.\n        public function applyTo(world:DisplayObject):void {\n            world.x = world.stage.stageWidth / 2 - x * zoom;\n            world.y = world.stage.stageHeight / 2 - y * zoom;\n            world.scaleX = zoom;\n            world.scaleY = zoom;\n        }\n    }\n}\n",
        "provenance": "original_source"
      },
      {
        "id": "ac29cdc7-fd4a-464e-8a2e-e64fbc5ca1bd",
        "name": "Random.as",
        "path": "scripts/game/Random.as",
        "source": "package game {\n    import flash.utils.getTimer;\n\n    /// Small deterministic PRNG (linear congruential generator). Seeded from\n    /// `getTimer()`; call `srand` for a fixed sequence in tests.\n    public class Random {\n        private static var state:Number = getTimer() + 1;\n\n        public static function srand(seed:Number):void {\n            state = seed;\n        }\n\n        /// Returns a value in [0, 1).\n        public static function next():Number {\n            state = (state * 1103515245 + 12345) % 2147483648;\n            return state / 2147483648;\n        }\n\n        /// Returns a value in [0, bound).\n        public static function range(bound:Number):Number {\n            return next() * bound;\n        }\n    }\n}\n",
        "provenance": "original_source"
      }
    ],
    "export": {
      "target": "avm2",

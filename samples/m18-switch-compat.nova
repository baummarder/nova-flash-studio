  "scripts": [
   {
    "id": "437c38a1-e361-445e-9b9f-d598a72875c7",
    "name": "Main.as",
    "path": "scripts/Main.as",
    "source": "package {\n    import flash.display.MovieClip;\n    import flash.events.Event;\n\n    public dynamic class Main extends MovieClip {\n        private var frame:int = 0;\n\n        public function Main() {\n            addEventListener(\"enterFrame\", onTick);\n        }\n\n        private function probe(value:int):int {\n            var out:int = 0;\n            switch (value) {\n                case 1:\n                    out += 10;      // fall-through into case 2\n                case 2:\n                    out += 20;\n                    break;\n                case 3, 4:\n                    out += 30;\n                    break;\n                default:\n                    out = -1;\n            }\n            return out;\n        }\n\n        private function onTick(e:Event):void {\n            frame++;\n            if (frame == 5) {\n                trace(\"SW1=\" + probe(1));   // 30 (fall-through 10+20)\n                trace(\"SW2=\" + probe(2));   // 20\n                trace(\"SW3=\" + probe(3));   // 30\n                trace(\"SW4=\" + probe(4));   // 30\n                trace(\"SW5=\" + probe(9));   // -1 (default)\n            }\n            if (frame == 21) {\n                trace(\"M18DONE\");\n            }\n        }\n    }\n}\n",
    "provenance": "original_source"
   }
  ],
